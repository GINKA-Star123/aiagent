# AIAgent Tencent Cloud deployment template.
# Copy this file to cloud.tencent.env on the server and replace every placeholder.
# Do not commit the real cloud.tencent.env file.

# ===== App =====
APP_ENV=production
APP_NAME=AIAgent
LOG_LEVEL=INFO

# ===== Cloud API =====
CLOUD_MODE=true
CLOUD_DEPLOY_REGION=tencent-cn
API_PUBLIC_BASE_URL=https://your-domain.example.com

API_HOST=0.0.0.0
API_PORT=8000

# 仅填写真实部署的 Web Origin，不要填写路径。
API_CORS_ORIGINS=https://app.your-domain.example.com
API_CORS_ALLOW_CREDENTIALS=true

# 閹稿鐤勯梽?Docker / Nginx 缂冩垹绮舵穱顔芥暭
# 娑撳秷顩﹂惄瀛樺复娴ｈ法鏁?0.0.0.0/0
API_TRUSTED_PROXIES=127.0.0.1,::1,172.18.0.0/16

# Admin APIs read this token from CLOUD_ADMIN_TOKEN.
# Clients should send it with the x-cloud-admin-token header.
CLOUD_ADMIN_TOKEN=change-this-admin-token

# docker-compose.tencent.yml injects REDIS_URL=qdrant/neo4j hosts for containers,
# but keeping explicit defaults here makes standalone container runs predictable.
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=aiagent:v1

# ===== Shared Execution State =====
EXECUTION_STATE_MODE=redis
EXECUTION_STATE_FAIL_CLOSED=true
EXECUTION_STATE_SESSION_TTL_SECONDS=86400
EXECUTION_STATE_THREAD_TTL_SECONDS=1800
EXECUTION_STATE_LOCK_TTL_SECONDS=60

# ===== Rate Limit / Concurrency =====
RATE_LIMIT_ENABLED=true
INFLIGHT_LIMIT_ENABLED=true
LIMITER_FAIL_OPEN=false

RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_MULTIMODAL_PER_MINUTE=5
RATE_LIMIT_VOICE_PER_MINUTE=5
RATE_LIMIT_REBUILD_PER_MINUTE=1

GLOBAL_INFLIGHT_LIMIT=100
CHAT_INFLIGHT_LIMIT=40
MULTIMODAL_INFLIGHT_LIMIT=10
VOICE_INFLIGHT_LIMIT=8
REBUILD_INFLIGHT_LIMIT=1
INFLIGHT_LEASE_SECONDS=120

# ===== COS / S3-compatible Object Storage =====
STORAGE_PROVIDER=cos
UPLOAD_MAX_BYTES=26214400
LOCAL_STORAGE_ROOT=data/cloud_storage

S3_ENDPOINT_URL=https://cos.ap-guangzhou.myqcloud.com
S3_REGION=ap-guangzhou
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-secret-id
S3_SECRET_ACCESS_KEY=your-secret-key
S3_PUBLIC_BASE_URL=https://your-bucket.cos.ap-guangzhou.myqcloud.com

# ===== OpenAI-compatible API Provider =====
# Use one OpenAI-compatible provider for main LLM, state, planner, memory, RAG, and vision.
SILICONFLOW_API=your-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# ===== Main LLM: API =====
LLM_PROVIDER=siliconflow
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
ENABLE_MOCK_LLM=false
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=600

# ===== State LLM: API =====
STATE_PROVIDER=siliconflow
STATE_MODEL=Qwen/Qwen2.5-7B-Instruct
ENABLE_MOCK_STATE=false

# ===== Planner LLM: API =====
PLANNER_PROVIDER=siliconflow
PLANNER_MODEL=Qwen/Qwen2.5-7B-Instruct
ENABLE_MOCK_PLANNER=false

# ===== GPU Services =====
GPU_LLM_BASE_URL=
GPU_TTS_BASE_URL=http://your-gpu-tts-endpoint
GPU_ASR_BASE_URL=
GPU_API_TOKEN=your-gpu-service-token

# ===== TTS: GPU service =====
TTS_PROVIDER=gpt_sovits
ENABLE_MOCK_TTS=false
ENABLE_LOCAL_AUDIO_PLAYBACK=false
TTS_TIMEOUT_SECONDS=60

GPT_SOVITS_BASE_URL=http://your-gpu-tts-endpoint
GPT_SOVITS_REF_AUDIO_PATH=
GPT_SOVITS_PROMPT_TEXT=娴ｇ姴銈介敍灞绢偨鏉╁骸娲栭弶銉ｂ偓?
GPT_SOVITS_PROMPT_LANG=zh
GPT_SOVITS_TEXT_LANG=zh

INDEX_TTS2_BASE_URL=
INDEX_TTS2_REF_AUDIO_PATH=
INDEX_TTS2_EMO_ALPHA=0.6
INDEX_TTS2_USE_EMO_TEXT=true
INDEX_TTS2_MAX_SEGMENT_LENGTH=20

VOXCPM_BASE_URL=

# ===== ASR: API =====
ASR_PROVIDER=api
ENABLE_MOCK_ASR=false
ASR_API_BASE_URL=https://your-asr-api-endpoint
ASR_API_KEY=your-asr-api-key
ASR_MODEL=whisper-large-v3
ASR_TIMEOUT_SECONDS=60
ASR_LANGUAGE=zh

ASR_MODEL_SIZE=
ASR_MODEL_PATH=
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_SAMPLE_RATE=16000
ASR_RECORD_SECONDS=10

VOICE_CHUNK_SECONDS=0.25
VOICE_MAX_RECORD_SECONDS=8.0
VOICE_MAX_UPLOAD_BYTES=26214400
VOICE_SILENCE_SECONDS=1.2
VOICE_ENERGY_THRESHOLD=0.015
VOICE_CALL_STORE_PROVIDER=redis
VOICE_CALL_STORE_FAIL_OPEN=false
VOICE_CALL_TTL_SECONDS=1800
VOICE_CALL_ENDED_TTL_SECONDS=300
VOICE_CALL_LOCK_TTL_SECONDS=15
VOICE_CALL_LOCK_WAIT_SECONDS=2.0

# ===== RAG Embedding: API =====
RAG_EMBEDDING_PROVIDER=siliconflow
RAG_EMBEDDING_MODEL_NAME=BAAI/bge-m3
RAG_EMBEDDING_MODEL_PATH=
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_LOCAL_FILES_ONLY=false
RAG_EMBEDDING_API_KEY_ENV=SILICONFLOW_API
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_DIMENSIONS=1024

RAG_CHUNK_SIZE=520
RAG_CHUNK_OVERLAP=80
RAG_BM25_TOP_K=6
RAG_VECTOR_TOP_K=6
RAG_FINAL_TOP_K=4
RAG_AUTO_REBUILD_ON_STALE=false
RAG_INDEX_MANIFEST_PATH=

# ===== Long-term Memory: API LLM / API Embedder, Qdrant / Neo4j =====
MEMORY_LLM_PROVIDER=openai
MEMORY_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
MEMORY_LLM_API_KEY_ENV=OPENAI_API_KEY

MEMORY_EMBEDDER_PROVIDER=openai
MEMORY_EMBEDDER_MODEL=BAAI/bge-m3
MEMORY_EMBEDDER_API_KEY_ENV=OPENAI_API_KEY

MEMORY_VECTOR_PROVIDER=qdrant
MEMORY_VECTOR_COLLECTION=aiagent_long_term_memory
MEMORY_EMBEDDING_DIMS=1024
MEMORY_RESET_VECTOR_STORE=false

MEMORY_LONG_TERM_DEFAULT_ENABLED=true
MEMORY_PREFERENCES_PATH=data/runtime/memory_preferences.json

MEMORY_PROMPT_MAX_CHARS=1200
MEMORY_PROMPT_PINNED_LIMIT=4
MEMORY_PROMPT_RELEVANT_LIMIT=6
MEMORY_PROMPT_ITEM_MAX_CHARS=120
MEMORY_WRITE_ASYNC_ENABLED=true
MEMORY_WRITE_MAX_PENDING=16
MEMORY_WRITE_AUDIT_TAIL_LIMIT=200

QDRANT_HOST=qdrant
QDRANT_PORT=6333

MEMORY_ENABLE_GRAPH=true
MEMORY_GRAPH_PROVIDER=neo4j
NEO4J_URL=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
NEO4J_DATABASE=neo4j

# ===== Vision: API =====
VISION_PROVIDER=siliconflow
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VISION_API_KEY_ENV=SILICONFLOW_API
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_TIMEOUT_SECONDS=60

VISION_UPLOAD_DIR=data/uploads/images
VISION_MAX_IMAGE_BYTES=12582912

VISION_CHARACTER_ROOT_DIR=data/characters
VISION_CHARACTER_INDEX_DIR=data/cache/vision/character_index
VISION_CHARACTER_EMBEDDING_MODEL_NAME=clip-ViT-B-32
VISION_CHARACTER_EMBEDDING_MODEL_PATH=
VISION_CHARACTER_EMBEDDING_DEVICE=cpu
VISION_CHARACTER_EMBEDDING_LOCAL_FILES_ONLY=false
VISION_CHARACTER_CONFIDENT_SCORE=0.78

# ===== Optional Desktop Client Compatibility =====
AIAGENT_API_BASE_URL=
AIAGENT_API_TIMEOUT=120
AIAGENT_DESKTOP_USER_ID=desktop-user
AIAGENT_DESKTOP_USERNAME=Desktop
AIAGENT_LIVE2D_MODEL3=

# Shared log format.
LOG_FORMAT=json

# ===== Live2D =====
LIVE2D_PROVIDER=mock
ENABLE_LIVE2D_RUNTIME=false

# ===== Persona fallback =====
PERSONA_NAME=
PERSONA_DESCRIPTION=
PERSONA_STYLE=
PERSONA_RULES=

# ===== Postgres / API / Worker =====
POSTGRES_PASSWORD=change-me-postgres-password

WEB_CONCURRENCY=2
WORKER_CONCURRENCY=1
TASK_QUEUE_NAME=default
TASK_POP_TIMEOUT_SECONDS=5
TASK_STALE_SECONDS=1800
